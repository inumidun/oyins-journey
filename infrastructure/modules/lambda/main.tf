# Lambda Functions Module - Following AWS Best Practices\n\n# Create Lambda layer for shared utilities\nresource \"aws_lambda_layer_version\" \"utils_layer\" {\n  filename         = \"${path.module}/layers/utils_layer.zip\"\n  layer_name       = \"${var.name_prefix}-utils-layer\"\n  description      = \"Shared utilities for Oyin's Journey Lambda functions\"\n  \n  compatible_runtimes = [\"python3.13\"]\n  \n  depends_on = [data.archive_file.utils_layer]\n}\n\n# Package utils layer\ndata \"archive_file\" \"utils_layer\" {\n  type        = \"zip\"\n  source_dir  = \"${path.module}/codes/layers\"\n  output_path = \"${path.module}/layers/utils_layer.zip\"\n}\n\n# Skills Lambda Function\nresource \"aws_lambda_function\" \"skills\" {\n  filename         = \"${path.module}/packages/skills.zip\"\n  function_name    = \"${var.name_prefix}-skills\"\n  role            = var.lambda_role_arn\n  handler         = \"skills.lambda_handler\"\n  runtime         = \"python3.13\"\n  timeout         = 30\n  memory_size     = 256\n  \n  layers = [aws_lambda_layer_version.utils_layer.arn]\n  \n  environment {\n    variables = {\n      SKILLS_TABLE = \"${var.name_prefix}-skills\"\n      LOG_LEVEL    = \"INFO\"\n    }\n  }\n  \n  tags = {\n    Name        = \"${var.name_prefix} Skills Function\"\n    Environment = var.environment\n    Function    = \"skills\"\n  }\n  \n  depends_on = [data.archive_file.skills]\n}\n\n# Package skills function\ndata \"archive_file\" \"skills\" {\n  type        = \"zip\"\n  source_dir  = \"${path.module}/codes/skills\"\n  output_path = \"${path.module}/packages/skills.zip\"\n}\n\n# Projects Lambda Function\nresource \"aws_lambda_function\" \"projects\" {\n  filename         = \"${path.module}/packages/projects.zip\"\n  function_name    = \"${var.name_prefix}-projects\"\n  role            = var.lambda_role_arn\n  handler         = \"projects.lambda_handler\"\n  runtime         = \"python3.13\"\n  timeout         = 30\n  memory_size     = 256\n  \n  layers = [aws_lambda_layer_version.utils_layer.arn]\n  \n  environment {\n    variables = {\n      PROJECTS_TABLE = \"${var.name_prefix}-projects\"\n      LOG_LEVEL      = \"INFO\"\n    }\n  }\n  \n  tags = {\n    Name        = \"${var.name_prefix} Projects Function\"\n    Environment = var.environment\n    Function    = \"projects\"\n  }\n  \n  depends_on = [data.archive_file.projects]\n}\n\n# Package projects function\ndata \"archive_file\" \"projects\" {\n  type        = \"zip\"\n  source_dir  = \"${path.module}/codes/projects\"\n  output_path = \"${path.module}/packages/projects.zip\"\n}\n\n# Certifications Lambda Function\nresource \"aws_lambda_function\" \"certifications\" {\n  filename         = \"${path.module}/packages/certifications.zip\"\n  function_name    = \"${var.name_prefix}-certifications\"\n  role            = var.lambda_role_arn\n  handler         = \"certifications.lambda_handler\"\n  runtime         = \"python3.13\"\n  timeout         = 30\n  memory_size     = 256\n  \n  layers = [aws_lambda_layer_version.utils_layer.arn]\n  \n  environment {\n    variables = {\n      CERTIFICATIONS_TABLE = \"${var.name_prefix}-certifications\"\n      LOG_LEVEL           = \"INFO\"\n    }\n  }\n  \n  tags = {\n    Name        = \"${var.name_prefix} Certifications Function\"\n    Environment = var.environment\n    Function    = \"certifications\"\n  }\n  \n  depends_on = [data.archive_file.certifications]\n}\n\n# Package certifications function\ndata \"archive_file\" \"certifications\" {\n  type        = \"zip\"\n  source_dir  = \"${path.module}/codes/certifications\"\n  output_path = \"${path.module}/packages/certifications.zip\"\n}\n\n# ADRs Lambda Function\nresource \"aws_lambda_function\" \"adrs\" {\n  filename         = \"${path.module}/packages/adrs.zip\"\n  function_name    = \"${var.name_prefix}-adrs\"\n  role            = var.lambda_role_arn\n  handler         = \"adrs.lambda_handler\"\n  runtime         = \"python3.13\"\n  timeout         = 30\n  memory_size     = 256\n  \n  layers = [aws_lambda_layer_version.utils_layer.arn]\n  \n  environment {\n    variables = {\n      ADRS_TABLE = \"${var.name_prefix}-adrs\"\n      LOG_LEVEL  = \"INFO\"\n    }\n  }\n  \n  tags = {\n    Name        = \"${var.name_prefix} ADRs Function\"\n    Environment = var.environment\n    Function    = \"adrs\"\n  }\n  \n  depends_on = [data.archive_file.adrs]\n}\n\n# Package adrs function\ndata \"archive_file\" \"adrs\" {\n  type        = \"zip\"\n  source_dir  = \"${path.module}/codes/adrs\"\n  output_path = \"${path.module}/packages/adrs.zip\"\n}\n\n# Version Lambda Function\nresource \"aws_lambda_function\" \"version\" {\n  filename         = \"${path.module}/packages/version.zip\"\n  function_name    = \"${var.name_prefix}-version\"\n  role            = var.lambda_role_arn\n  handler         = \"version.lambda_handler\"\n  runtime         = \"python3.13\"\n  timeout         = 30\n  memory_size     = 256\n  \n  layers = [aws_lambda_layer_version.utils_layer.arn]\n  \n  environment {\n    variables = {\n      VERSIONS_TABLE = \"${var.name_prefix}-versions\"\n      LOG_LEVEL      = \"INFO\"\n    }\n  }\n  \n  tags = {\n    Name        = \"${var.name_prefix} Version Function\"\n    Environment = var.environment\n    Function    = \"version\"\n  }\n  \n  depends_on = [data.archive_file.version]\n}\n\n# Package version function\ndata \"archive_file\" \"version\" {\n  type        = \"zip\"\n  source_dir  = \"${path.module}/codes/version\"\n  output_path = \"${path.module}/packages/version.zip\"\n}\n\n# CloudWatch Log Groups\nresource \"aws_cloudwatch_log_group\" \"skills_logs\" {\n  name              = \"/aws/lambda/${aws_lambda_function.skills.function_name}\"\n  retention_in_days = 14\n  \n  tags = {\n    Name        = \"${var.name_prefix} Skills Logs\"\n    Environment = var.environment\n  }\n}\n\nresource \"aws_cloudwatch_log_group\" \"projects_logs\" {\n  name              = \"/aws/lambda/${aws_lambda_function.projects.function_name}\"\n  retention_in_days = 14\n  \n  tags = {\n    Name        = \"${var.name_prefix} Projects Logs\"\n    Environment = var.environment\n  }\n}\n\nresource \"aws_cloudwatch_log_group\" \"certifications_logs\" {\n  name              = \"/aws/lambda/${aws_lambda_function.certifications.function_name}\"\n  retention_in_days = 14\n  \n  tags = {\n    Name        = \"${var.name_prefix} Certifications Logs\"\n    Environment = var.environment\n  }\n}\n\nresource \"aws_cloudwatch_log_group\" \"adrs_logs\" {\n  name              = \"/aws/lambda/${aws_lambda_function.adrs.function_name}\"\n  retention_in_days = 14\n  \n  tags = {\n    Name        = \"${var.name_prefix} ADRs Logs\"\n    Environment = var.environment\n  }\n}\n\nresource \"aws_cloudwatch_log_group\" \"version_logs\" {\n  name              = \"/aws/lambda/${aws_lambda_function.version.function_name}\"\n  retention_in_days = 14\n  \n  tags = {\n    Name        = \"${var.name_prefix} Version Logs\"\n    Environment = var.environment\n  }\n}